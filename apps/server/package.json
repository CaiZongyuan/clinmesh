{
  "name": "@clinmesh/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @clinmesh/web build && wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .wrangler"
  },
  "dependencies": {
    "@clinmesh/contracts": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@clinmesh/web": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.124.0"
  }
}
