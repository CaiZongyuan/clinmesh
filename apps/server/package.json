{
  "name": "@clinmesh/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @clinmesh/web build && pnpm db:migrate && tsx watch src/index.ts",
    "build": "vite build",
    "db": "tsx src/database-cli.ts",
    "db:backup": "tsx src/database-cli.ts backup",
    "db:migrate": "tsx src/database-cli.ts migrate",
    "db:reindex": "tsx src/database-cli.ts reindex",
    "db:restore": "tsx src/database-cli.ts restore",
    "db:verify": "tsx src/database-cli.ts verify",
    "reference-db": "tsx src/reference-database-cli.ts",
    "reference:sync": "tsx src/reference-sync.ts",
    "performance": "tsx src/performance-cli.ts",
    "smoke:patient-brief:live": "tsx src/patient-brief-live-smoke.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@clinmesh/contracts": "workspace:*",
    "@hono/node-server": "catalog:",
    "better-auth": "1.7.1",
    "better-sqlite3": "13.0.3",
    "csv-parse": "6.1.0",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.3.6",
    "hono": "catalog:",
    "mdast-util-from-markdown": "2.0.3",
    "uuid": "13.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clinmesh/web": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.8",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
