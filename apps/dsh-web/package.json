{
  "name": "@clinmesh/dsh-web",
  "version": "0.0.1",
  "private": true,
  "description": "ClinMesh application adapter for DSH Web",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build:styles": "tsx src/build-styles.ts",
    "build": "pnpm run build:styles && bun node_modules/dsh-react-surface-build/src/cli.ts . && bun src/verify-artifact.ts",
    "typecheck": "pnpm run build:styles && tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf lib coverage"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "reactSurface": {
      "id": "clinmesh.his",
      "projectRoot": "../.."
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-react-surface",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": [
        "dsh-react-surface/client"
      ]
    }
  },
  "dependencies": {
    "@clinmesh/contracts": "workspace:*",
    "@clinmesh/web": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "dsh-react-surface": "0.0.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.2",
    "@clinmesh/ui": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "1.4.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dsh-react-surface": "file:../../vendor/dsh-react-surface/packages/runtime",
    "dsh-react-surface-build": "file:../../vendor/dsh-react-surface/packages/build",
    "playwright-core": "1.62.1",
    "postcss": "8.5.6",
    "postcss-selector-parser": "7.1.0",
    "react-dom": "catalog:",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
