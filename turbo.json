{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CLINMESH_AUTH_SECRET",
        "CLINMESH_BUSY_TIMEOUT_MS",
        "CLINMESH_CURSOR_SECRET",
        "CLINMESH_DATABASE_PATH",
        "CLINMESH_DEMO_PASSWORD",
        "CLINMESH_DSH_BRIDGE_SECRET",
        "CLINMESH_DSH_UPSTREAM_ORIGIN",
        "CLINMESH_HOST",
        "CLINMESH_PORT",
        "CLINMESH_PUBLIC_ORIGIN",
        "CLINMESH_SYNTHEA_PROVIDER_URL",
        "CLINMESH_TRUSTED_ORIGINS",
        "CLINMESH_WEB_ROOT"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "lint": {},
    "clean": {
      "cache": false
    }
  }
}
