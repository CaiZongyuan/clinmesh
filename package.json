{
  "name": "clinmesh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "dev": "tsx watch src/server/node-server.ts",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --local",
    "start": "node dist/server/node-server.js",
    "clinmesh": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts *.config.ts .dependency-cruiser.cjs --deny-warnings",
    "lint:boundaries": "tsx scripts/lint-boundaries.ts",
    "verify:docs": "tsx scripts/verify-docs.ts",
    "verify:worker": "wrangler deploy --dry-run --outfile dist/worker.bundle && node scripts/verify-worker-size.ts",
    "test": "vitest run",
    "build": "vite build && vite build --ssr src/server/node-server.ts --outDir dist/server",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm verify:docs && pnpm test && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@hono/node-server": "2.1.11",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.3",
    "@tanstack/react-router": "1.170.46",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.20",
    "lucide-react": "1.78.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "uuid": "14.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261123.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/better-sqlite3": "9.6.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "dependency-cruiser": "18.9.0",
    "github-slugger": "2.0.0",
    "jsdom": "31.0.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "oxlint": "1.94.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.166.0"
  }
}
