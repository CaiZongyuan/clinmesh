# Local synthetic demo only. Replace secrets before any shared deployment.
CLINMESH_AUTH_SECRET=dev-only-auth-secret-change-before-sharing-2026
CLINMESH_CURSOR_SECRET=dev-only-cursor-secret-change-before-sharing-2026
CLINMESH_DATABASE_PATH=.data/clinmesh.sqlite
# Read-only authoring reference database, materialized by `pnpm reference:sync` (locked releases).
CLINMESH_REFERENCE_DATABASE_PATH=.data/clinmesh-reference.sqlite
# Fixed guideline Release, automatically prepared before Server, DSH and LAN startup.
CLINMESH_GUIDELINE_DATABASE_PATH=.data/clinmesh-guidelines.sqlite
# Internal testing may use registered, verified sources while retaining their original rights status.
# Other deployments keep the default policy. Changes require a Server restart.
# CLINMESH_GUIDELINE_DEPLOYMENT_POLICY=internal-testing
# Enable only after verifying this deployment and its model use are non-commercial. Default: false.
# CLINMESH_GUIDELINE_NON_COMMERCIAL_USE=false
# Optional imaging asset store, populated by `pnpm imaging:sync` (default: .data/imaging-assets).
# CLINMESH_IMAGING_ASSET_DIRECTORY=.data/imaging-assets
# Optional pathology slide store, populated by `pnpm pathology:sync` (default: .data/pathology-assets).
# CLINMESH_PATHOLOGY_ASSET_DIRECTORY=.data/pathology-assets
# Optional explicit override; defaults to compositeRelease.releaseId from reference-data.lock.json.
# CLINMESH_REFERENCE_RELEASE_ID=clinmesh-cn-health-2026-09-15.r1
# Optional DRG simulation rules. Configure both only after completing the version-bound review.
# Downloading or preparing offline sources does not enable these rules.
# CLINMESH_DRG_RULES_DIRECTORY=.data/drg-rules/clinmesh-chs-drg-3.0-2026-10-20
# CLINMESH_DRG_RULES_REVIEW_PATH=.data/drg-rules-review.json
CLINMESH_DEMO_PASSWORD=ClinMesh-demo-password-2026!
# Optional DSH Host/Server shared secret for model calls, Page Context and execution proofs.
# CLINMESH_DSH_BRIDGE_SECRET=replace-with-at-least-32-random-bytes
# Optional DSH Host proxy target when ClinMesh Server does not use its default port.
# CLINMESH_DSH_UPSTREAM_ORIGIN=http://127.0.0.1:51868
CLINMESH_HOST=127.0.0.1
CLINMESH_PORT=51868
CLINMESH_BUSY_TIMEOUT_MS=5000

# Server selects its model source at startup. pnpm dev:dsh sets this to dsh automatically.
# CLINMESH_AI_SOURCE=openai
# DSH mode uses Settings > General > ClinMesh model, with no duplicate Provider key/model vars.
# CLINMESH_DSH_MODEL_ORIGIN=http://127.0.0.1:3080
# Optional standalone OpenAI-compatible configuration. Keep credentials local.
# CLINMESH_AI_BASE_URL=https://provider.example/v1
# CLINMESH_AI_API_KEY=replace-with-local-key
# CLINMESH_AI_BRIEF_MODEL=provider/brief-model
# CLINMESH_AI_INVESTIGATION_MODEL=provider/investigation-model
# CLINMESH_AI_CONSULTATION_MODEL=provider/consultation-model
# 实时整理可固定独立模型；DSH 使用完整 dsh:{"provider":"...","model":"..."} 路由。
# 未设置时沿用问诊模型；已开始的批次保持原模型，人工重试创建新批次。
# CLINMESH_AI_RECORDING_MODEL=provider/recording-model
# DSH 的低延迟路由应显式选择 Provider 支持的思考强度，例如：
# CLINMESH_AI_RECORDING_MODEL=dsh:{"provider":"deepseek-official","model":"deepseek-flash","reasoningEffort":"off"}

# CLINMESH_AI_CATALOG_ENRICHMENT_MODEL=provider/catalog-enrichment-model
# 单次模型生成预算：DSH 默认 120000，OpenAI 默认 60000；范围 100–600000。
# CLINMESH_AI_TIMEOUT_MS=120000
# CLINMESH_AI_MAX_RESPONSE_BYTES=1048576
# 可选部署总政策 JSON；默认启用，requests/tokens/cny 各自无限，保留有界自动重试；修改后重启 Server。
# 文件内容示例：{"enabled":true,"requests":1000,"tokens":null,"cny":null,"automaticRetries":true}。
# requests/tokens 为非负安全整数，cny 为最多 6 位小数的非负人民币金额；null 表示无限。
# CLINMESH_MODEL_CONTROL_PATH=.data/model-control.json
# 可选统一价表与汇率 JSON；按 Provider 及 requestedModel 精确匹配，DSH 使用完整固定路由。
# 单价为原币/百万 Token；金额与汇率最多 6 位小数。完整示例和当前有限保护边界见 docs/deployment.md 的“模型用量”。
# CLINMESH_MODEL_PRICING_PATH=.data/model-pricing.json

# Recommended local Synthea Provider endpoint (Docker or JDK 17).
CLINMESH_SYNTHEA_PROVIDER_URL=http://127.0.0.1:51878
CLINMESH_SYNTHEA_PROVIDER_PORT=51878

# Optional origin and static asset overrides.
# CLINMESH_PUBLIC_ORIGIN=http://127.0.0.1:51868
# Add the actual DSH Web origin when using the React Surface (default local port: 3080).
# CLINMESH_TRUSTED_ORIGINS=http://127.0.0.1:51868,http://127.0.0.1:51888,http://127.0.0.1:3080
# CLINMESH_WEB_ROOT=apps/web/dist
