# Local synthetic demo only. Replace secrets before any shared deployment.
CLINMESH_AUTH_SECRET=dev-only-auth-secret-change-before-sharing-2026
CLINMESH_CURSOR_SECRET=dev-only-cursor-secret-change-before-sharing-2026
CLINMESH_DATABASE_PATH=.data/clinmesh.sqlite
CLINMESH_DEMO_PASSWORD=ClinMesh-demo-password-2026!
CLINMESH_HOST=127.0.0.1
CLINMESH_PORT=51868
CLINMESH_BUSY_TIMEOUT_MS=5000

# Recommended local Synthea Provider endpoint (Docker or JDK 17).
CLINMESH_SYNTHEA_PROVIDER_URL=http://127.0.0.1:45873

# Optional origin and static asset overrides.
# CLINMESH_PUBLIC_ORIGIN=http://127.0.0.1:51868
# CLINMESH_TRUSTED_ORIGINS=http://127.0.0.1:51868,http://127.0.0.1:51888
# CLINMESH_WEB_ROOT=apps/web/dist
