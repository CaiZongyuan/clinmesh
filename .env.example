# Local synthetic demo only. Replace secrets before any shared deployment.
CLINMESH_AUTH_SECRET=dev-only-auth-secret-change-before-sharing-2026
CLINMESH_CURSOR_SECRET=dev-only-cursor-secret-change-before-sharing-2026
CLINMESH_DATABASE_PATH=.data/clinmesh.sqlite
# Read-only authoring reference database, materialized by `pnpm reference:sync` (locked releases).
CLINMESH_REFERENCE_DATABASE_PATH=.data/clinmesh-reference.sqlite
# Optional explicit override; defaults to compositeRelease.releaseId from reference-data.lock.json.
# CLINMESH_REFERENCE_RELEASE_ID=clinmesh-cn-health-2026-09-15.r1
CLINMESH_DEMO_PASSWORD=ClinMesh-demo-password-2026!
# Optional DSH Host/Hono shared secret for Agent Page Context and execution proofs.
# CLINMESH_DSH_BRIDGE_SECRET=replace-with-at-least-32-random-bytes
# Optional DSH Host proxy target when ClinMesh Server does not use its default port.
# CLINMESH_DSH_UPSTREAM_ORIGIN=http://127.0.0.1:51868
CLINMESH_HOST=127.0.0.1
CLINMESH_PORT=51868
CLINMESH_BUSY_TIMEOUT_MS=5000

# Optional OpenAI-compatible Agent configuration. Keep credentials local.
# CLINMESH_AI_BASE_URL=https://provider.example/v1
# CLINMESH_AI_API_KEY=replace-with-local-key
# CLINMESH_AI_BRIEF_MODEL=provider/brief-model
# CLINMESH_AI_INVESTIGATION_MODEL=provider/investigation-model
# CLINMESH_AI_CATALOG_ENRICHMENT_MODEL=provider/catalog-enrichment-model
# CLINMESH_AI_TIMEOUT_MS=60000
# CLINMESH_AI_MAX_RESPONSE_BYTES=1048576

# Recommended local Synthea Provider endpoint (Docker or JDK 17).
CLINMESH_SYNTHEA_PROVIDER_URL=http://127.0.0.1:51878
CLINMESH_SYNTHEA_PROVIDER_PORT=51878

# Optional origin and static asset overrides.
# CLINMESH_PUBLIC_ORIGIN=http://127.0.0.1:51868
# Add the actual DSH Web origin when using the React Surface (default local port: 3080).
# CLINMESH_TRUSTED_ORIGINS=http://127.0.0.1:51868,http://127.0.0.1:51888,http://127.0.0.1:3080
# CLINMESH_WEB_ROOT=apps/web/dist
